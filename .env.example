# Copie para .env e preencha. O .env não vai para o git.

# Login com Discord + sala da call (deixe vazio para desligar)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Qualquer texto longo e aleatório (assina o cookie de login)
SESSION_SECRET=
# Só se o site for aberto por outro endereço que não http://localhost:4200
# DISCORD_REDIRECT_URI=http://localhost:4200/api/discord/callback

# --- Compartilhar com amigos pelo Tailscale (veja o README) ---
# IP do Tailscale deste PC (comando: tailscale ip -4). O LiveKit anuncia esse IP para a mídia.
# NODE_IP=100.x.y.z
# Endereço seguro do LiveKit, com a porta 7443 do `tailscale serve`
# LIVEKIT_PUBLIC_URL=wss://SEU-PC.SUA-REDE.ts.net:7443
# Retorno do login do Discord pelo endereço https do Tailscale
# DISCORD_REDIRECT_URI=https://SEU-PC.SUA-REDE.ts.net/api/discord/callback

# Clipes (Cloudflare R2). Opcional: vazio = sem botão de clipe.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
