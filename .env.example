# Copie para .env e preencha. O .env não vai para o git.

# Login com Discord + sala da call (deixe vazio para desligar)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Qualquer texto longo e aleatório (assina o cookie de login)
SESSION_SECRET=
