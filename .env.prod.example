# Copie para .env.prod (cp .env.prod.example .env.prod) e preencha. NUNCA vai para o git.

# Domínio que aponta (registro A) para o IP da VPS. Ex.: noveau.seudominio.com
DOMAIN=

# Chave e segredo do LiveKit. Gere o segredo com:  openssl rand -hex 32
LIVEKIT_API_KEY=noveau
LIVEKIT_API_SECRET=

# Opcional: senha extra da instância (se preencher, só entra quem souber)
INSTANCE_SECRET=

# Login com Discord (os mesmos valores do Developer Portal)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Texto longo e aleatório que assina o cookie de login:  openssl rand -hex 32
SESSION_SECRET=
